<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:UltimateManager.ViewModels"
             x:Class="UltimateManager.Views.ClientDynamicRecordPage"
             x:DataType="viewModels:ClientDynamicRecordViewModel"
             Title="Fiche personnalisée">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Champ" Clicked="OnAddFieldClicked" />
        <ToolbarItem Text="Template" Clicked="OnEditTemplateClicked" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
            <Label Text="{Binding TemplateName}"
                   FontFamily="OpenSansSemibold"
                   FontSize="26" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Blocks}"
                                 Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DynamicRecordBlockItem">
                        <Border Padding="16"
                                Stroke="{StaticResource Gray200}"
                                StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:DynamicRecordFieldItem">
                                            <VerticalStackLayout Spacing="5">
                                                <Label Text="{Binding Label}" />
                                                <Entry Text="{Binding Value}"
                                                       IsVisible="{Binding IsSimple}"
                                                       Placeholder="Saisir une valeur" />
                                                <Editor Text="{Binding Value}"
                                                        IsVisible="{Binding IsLongText}"
                                                        AutoSize="TextChanges"
                                                        MinimumHeightRequest="100" />
                                                <CheckBox IsVisible="{Binding IsCheckbox}"
                                                          IsChecked="{Binding BooleanValue}" />
                                                <DatePicker IsVisible="{Binding IsDate}"
                                                            Date="{Binding DateValue}" />
                                                <Picker IsVisible="{Binding IsDropdown}"
                                                        ItemsSource="{Binding Options}"
                                                        SelectedItem="{Binding Value}" />
                                                <Grid IsVisible="{Binding IsPhone}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Entry Text="{Binding CountryCode}"
                                                           Keyboard="Telephone"
                                                           Placeholder="+33"
                                                           WidthRequest="80" />
                                                    <Entry Grid.Column="1"
                                                           Text="{Binding PhoneNumber}"
                                                           Keyboard="Telephone"
                                                           Placeholder="Téléphone" />
                                                </Grid>
                                                <HorizontalStackLayout IsVisible="{Binding IsPhone}" Spacing="8">
                                                    <CheckBox IsChecked="{Binding IsPrimaryPhone}" />
                                                    <Label Text="Numéro principal" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Grid IsVisible="{Binding IsAddress}"
                                                      ColumnDefinitions="*,Auto"
                                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                      ColumnSpacing="8"
                                                      RowSpacing="6">
                                                    <Entry Text="{Binding Address}" Placeholder="Rue" />
                                                    <Entry Grid.Column="1" Text="{Binding AddressNumber}" Placeholder="N°" />
                                                    <Entry Grid.Row="1" Text="{Binding PostalCode}" Placeholder="Code postal" />
                                                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding City}" Placeholder="Ville" />
                                                    <Entry Grid.Row="2" Text="{Binding Country}" Placeholder="Pays" Grid.ColumnSpan="2" />
                                                    <Button Grid.Row="3" Text="Choisir sur la carte" Clicked="OnPickLocationClicked" Grid.ColumnSpan="2" HorizontalOptions="Start" />
                                                </Grid>
                                                <Grid IsVisible="{Binding IsGeoPoint}" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Entry Text="{Binding Latitude}" Placeholder="Latitude" Keyboard="Numeric" />
                                                    <Entry Grid.Column="1" Text="{Binding Longitude}" Placeholder="Longitude" Keyboard="Numeric" />
                                                </Grid>
                                                <Grid IsVisible="{Binding IsDocument}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Entry Text="{Binding DocumentPath}" IsReadOnly="True" Placeholder="Aucun document" />
                                                    <Button Grid.Column="1" Text="Choisir" Clicked="OnPickDocumentClicked" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Enregistrer" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
