<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:UltimateManager.ViewModels"
             x:Class="UltimateManager.Views.ClientEditPage"
             xmlns:models="clr-namespace:UltimateManager.Models.DynamicForms"
             x:DataType="viewModels:ClientEditViewModel"
             Title="Client">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
            <Label Text="Informations personnelles" Style="{StaticResource SectionTitle}" />
            <Label Text="Modèle de fiche" Style="{StaticResource SectionTitle}" />
            <Picker ItemsSource="{Binding Templates}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                    Title="Choisir un modèle" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Prénom *" />
                <Entry Text="{Binding FirstName}"
                       Placeholder="Prénom"
                       ReturnType="Next" />
                <Label Text="{Binding FirstNameError}"
                       IsVisible="{Binding FirstNameError, Converter={StaticResource StringNotEmptyConverter}}"
                       TextColor="#C62828"
                       FontSize="12" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Nom *" />
                <Entry Text="{Binding LastName}"
                       Placeholder="Nom"
                       ReturnType="Next" />
                <Label Text="{Binding LastNameError}"
                       IsVisible="{Binding LastNameError, Converter={StaticResource StringNotEmptyConverter}}"
                       TextColor="#C62828"
                       FontSize="12" />
            </VerticalStackLayout>

            <Label Text="Coordonnées" Style="{StaticResource SectionTitle}" />
            <Entry Text="{Binding PhoneNumber}"
                   Placeholder="Téléphone"
                   Keyboard="Telephone"
                   ReturnType="Next" />
            <Entry Text="{Binding Email}"
                   Placeholder="Email"
                   Keyboard="Email"
                   ReturnType="Next" />

            <Label Text="Adresse" Style="{StaticResource SectionTitle}" />
             <Entry Text="{Binding Address, Mode=TwoWay}"
                   Placeholder="Adresse"
                    IsTextPredictionEnabled="False"
                    ClearButtonVisibility="WhileEditing"
                   ReturnType="Next" />
            <Label Text="Localisation GPS" Style="{StaticResource SectionTitle}" />
            <Button Text="Choisir sur la carte"
                    Command="{Binding PickLocationCommand}"
                    HorizontalOptions="Start" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Entry ClassId="Latitude"
                       Text="{Binding Latitude, Mode=TwoWay}"
                       Placeholder="Latitude"
                       Keyboard="Numeric"
                       ReturnType="Next" />
                <Entry ClassId="Longitude"
                       Grid.Column="1"
                       Text="{Binding Longitude, Mode=TwoWay}"
                       Placeholder="Longitude"
                       Keyboard="Numeric"
                       ReturnType="Next" />
            </Grid>

            <Label Text="Commentaire" Style="{StaticResource SectionTitle}" />
            <Editor Text="{Binding Comment}"
                    Placeholder="Ajouter un commentaire"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="120" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Annuler"
                        Clicked="OnCancelClicked"
                        BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource Gray900}" />
                <Button Grid.Column="1"
                        Text="Enregistrer"
                        Clicked="OnSaveClicked"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
