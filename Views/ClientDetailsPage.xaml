<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:UltimateManager.ViewModels"
             x:Class="UltimateManager.Views.ClientDetailsPage"
             x:Name="DetailsPage"
             x:DataType="viewModels:ClientDetailsViewModel"
             Title="Fiche client">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="20">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding CurrentClient, Converter={StaticResource NullToFalseConverter}}"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                                 Spacing="4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Text="✎"
                            Clicked="OnEditClicked"
                            Padding="8,4"
                            VerticalOptions="Start"
                            IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"
                            SemanticProperties.Description="Ouvrir l’éditeur complet de la fiche" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Entry Text="{Binding FirstName}"
                               FontFamily="OpenSansSemibold"
                               FontSize="28"
                               TextColor="{StaticResource Gray900}"
                               Placeholder="Prénom"
                               IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                        <Entry Grid.Column="1"
                               Text="{Binding LastName}"
                               FontFamily="OpenSansSemibold"
                               FontSize="28"
                               TextColor="{StaticResource Gray900}"
                               Placeholder="Nom"
                               IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                    </Grid>
                </Grid>
                <Label Text="Fiche client"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <Label Text="Informations" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EditableDynamicBlocks}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DynamicRecordBlockItem">
                            <Border Padding="14"
                                    Stroke="{StaticResource Gray200}"
                                    StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout Spacing="8">
                                    <Entry Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           IsReadOnly="True" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:DynamicRecordFieldItem">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding Label}"
                                                           FontSize="13"
                                                           TextColor="{StaticResource Gray500}" />
                                                    <Entry Text="{Binding Value}"
                                                           IsVisible="{Binding IsSimple}"
                                                           Placeholder="Saisir une valeur"
                                                           IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                    <Editor Text="{Binding Value}"
                                                            IsVisible="{Binding IsLongText}"
                                                            AutoSize="TextChanges"
                                                            MinimumHeightRequest="90"
                                                            IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                    <CheckBox IsVisible="{Binding IsCheckbox}"
                                                              IsChecked="{Binding BooleanValue}"
                                                              HorizontalOptions="Start"
                                                              IsEnabled="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing}" />
                                                    <DatePicker IsVisible="{Binding IsDate}"
                                                                Date="{Binding DateValue}"
                                                                IsEnabled="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing}" />
                                                    <Picker IsVisible="{Binding IsDropdown}"
                                                            ItemsSource="{Binding Options}"
                                                            SelectedItem="{Binding Value}"
                                                            IsEnabled="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing}" />
                                                    <Grid IsVisible="{Binding IsPhone}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <Entry Text="{Binding CountryCode}"
                                                               Keyboard="Telephone"
                                                               Placeholder="+33"
                                                               WidthRequest="80"
                                                               IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                        <Entry Grid.Column="1"
                                                               Text="{Binding PhoneNumber}"
                                                               Keyboard="Telephone"
                                                               Placeholder="Téléphone"
                                                               IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                        <Button Grid.Column="2"
                                                                Text="Appeler"
                                                                Clicked="OnCallDynamicFieldClicked"
                                                                Padding="8,3"
                                                                IsVisible="{Binding HasPhoneValue}" />
                                                    </Grid>
                                                    <VerticalStackLayout IsVisible="{Binding IsAddress}" Spacing="6">
                                                        <Entry Text="{Binding Address}"
                                                               Placeholder="Adresse"
                                                               IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                            <Entry Text="{Binding Latitude}"
                                                                   Placeholder="Latitude"
                                                                   Keyboard="Numeric"
                                                                   IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                            <Entry Grid.Column="1"
                                                                   Text="{Binding Longitude}"
                                                                   Placeholder="Longitude"
                                                                   Keyboard="Numeric"
                                                                   IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                        </Grid>
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Button Text="Choisir sur la carte"
                                                                    Clicked="OnPickLocationClicked"
                                                                    Padding="10,4"
                                                                     IsVisible="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing}" />
                                                            <Button Text="Ouvrir dans Google Maps" Clicked="OnOpenMapClicked" Padding="10,4" />
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout IsVisible="{Binding IsGeoPoint}" Spacing="6">
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                            <Entry Text="{Binding Latitude}"
                                                                   Placeholder="Latitude"
                                                                   Keyboard="Numeric"
                                                                   IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                            <Entry Grid.Column="1"
                                                                   Text="{Binding Longitude}"
                                                                   Placeholder="Longitude"
                                                                   Keyboard="Numeric"
                                                                   IsReadOnly="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing, Converter={StaticResource InverseBooleanConverter}}" />
                                                        </Grid>
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Button Text="Choisir sur la carte"
                                                                    Clicked="OnPickLocationClicked"
                                                                    Padding="10,4"
                                                                     IsVisible="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing}" />
                                                            <Button Text="Ouvrir dans Google Maps" Clicked="OnOpenMapClicked" Padding="10,4" />
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                    <Grid IsVisible="{Binding IsDocument}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Entry Text="{Binding DocumentPath}" IsReadOnly="True" Placeholder="Aucun document" />
                                                        <Button Grid.Column="1"
                                                                Text="Choisir"
                                                                Clicked="OnPickDocumentClicked"
                                                                IsVisible="{Binding Source={x:Reference DetailsPage}, Path=BindingContext.IsEditing}" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Grid IsVisible="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"
                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Button Text="Modifier" Clicked="OnModifyClicked" />
                <Button Text="Supprimer"
                        Grid.Column="1"
                        Clicked="OnDeleteClicked"
                        BackgroundColor="#C62828"
                        HorizontalOptions="Fill" />
            </Grid>
            <Grid IsVisible="{Binding IsEditing}" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Annuler" Clicked="OnCancelEditClicked" />
                <Button Grid.Column="1" Text="Enregistrer" Clicked="OnSaveEditClicked" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
