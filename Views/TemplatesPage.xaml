<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UltimateManager.Models.DynamicForms"
             xmlns:viewModels="clr-namespace:UltimateManager.ViewModels"
             x:Class="UltimateManager.Views.TemplatesPage"
             x:DataType="viewModels:TemplatesViewModel"
             Title="Modèles de fiches">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>
    <Grid Padding="20,16" RowDefinitions="Auto,*">
        <Label Text="Modèles personnalisés"
               Style="{StaticResource SectionTitle}" />
        <CollectionView Grid.Row="1"
                        Margin="0,16,0,0"
                        ItemsSource="{Binding Templates}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EntityTemplate">
                    <Border Margin="0,0,0,12"
                            Padding="16"
                            Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTemplateTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="17" />
                                <Label Text="{Binding EntityType}"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Par défaut"
                                    Clicked="OnSetDefaultClicked"
                                    Padding="8,0"
                                    VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text=">"
                                   FontSize="24"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
