<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UltimateManager.Views.LocationPickerPage"
             Title="Choisir la localisation">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <SearchBar x:Name="SearchBar"
                   Placeholder="Rechercher une adresse"
                   TextChanged="OnSearchTextChanged"
                   SearchButtonPressed="OnSearchButtonPressed"
                   Margin="12,8" />

        <CollectionView x:Name="Suggestions"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnSuggestionSelected"
                        IsVisible="False"
                        MaximumHeightRequest="220"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Description}"
                           Padding="16,12"
                           LineBreakMode="TailTruncation" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ContentView x:Name="MapHost"
                     Grid.Row="2"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />

        <Border Grid.Row="3"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="16"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Touchez la carte ou choisissez une adresse"
                           FontAttributes="Bold" />
                    <Label x:Name="CoordinatesLabel"
                           Text="Aucun point sélectionné"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button x:Name="ConfirmButton"
                        Grid.Column="1"
                        Text="Valider"
                        Clicked="OnConfirmClicked"
                        IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
